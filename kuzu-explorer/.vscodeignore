.vscode/**
.vscode-test/**
src/**
.gitignore
tsconfig.json
**/*.map
**/*.ts
media/icon-source.svg
*.vsix
node_modules/.bin/**

# kuzu: drop C++ sources and other-platform prebuilt binaries (runtime needs
# only the wrapper JS + compiled kuzujs.node).
node_modules/kuzu/kuzu-source/**
node_modules/kuzu/prebuilt/**

# cytoscape: the graph webview only loads dist/cytoscape.min.js.
node_modules/cytoscape/src/**
node_modules/cytoscape/playwright-page/**
node_modules/cytoscape/playwright-tests/**
node_modules/cytoscape/tests-examples/**
node_modules/cytoscape/*.mjs
node_modules/cytoscape/*.md
node_modules/cytoscape/playwright.config.js

