{
  "name": "kuzu-explorer",
  "displayName": "Kuzu Explorer",
  "description": "Browse Kuzu graph databases inside VS Code: schema tree, table data, Cypher queries and a graph view.",
  "version": "0.1.0",
  "publisher": "gaintlabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gaintlabs/kuzu-viewer.git",
    "directory": "kuzu-explorer"
  },
  "author": "gaintlabs",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "kuzuExplorer.dbEditor",
        "displayName": "Kuzu Database (Graph)",
        "selector": [
          { "filenamePattern": "*.kuzu" },
          { "filenamePattern": "*.kz" },
          { "filenamePattern": "*.kuzudb" }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kuzuExplorer",
          "title": "Kuzu Explorer",
          "icon": "media/kuzu.svg"
        }
      ]
    },
    "views": {
      "kuzuExplorer": [
        {
          "id": "kuzuExplorer.database",
          "name": "Database",
          "icon": "media/kuzu.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "kuzuExplorer.database",
        "contents": "No Kuzu database connected.\n[Connect to Database](command:kuzuExplorer.connect)"
      }
    ],
    "commands": [
      {
        "command": "kuzuExplorer.connect",
        "title": "Kuzu: Connect to Database",
        "icon": "$(plug)"
      },
      {
        "command": "kuzuExplorer.disconnect",
        "title": "Kuzu: Disconnect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "kuzuExplorer.refresh",
        "title": "Kuzu: Refresh Schema",
        "icon": "$(refresh)"
      },
      {
        "command": "kuzuExplorer.runQuery",
        "title": "Kuzu: Run Cypher Query",
        "icon": "$(play)"
      },
      {
        "command": "kuzuExplorer.showGraph",
        "title": "Kuzu: Show Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "kuzuExplorer.openTable",
        "title": "Kuzu: Open Table"
      },
      {
        "command": "kuzuExplorer.openDatabaseFile",
        "title": "Open as Kuzu Database"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kuzuExplorer.connect",
          "when": "view == kuzuExplorer.database && !kuzuExplorer.connected",
          "group": "navigation@1"
        },
        {
          "command": "kuzuExplorer.runQuery",
          "when": "view == kuzuExplorer.database && kuzuExplorer.connected",
          "group": "navigation@1"
        },
        {
          "command": "kuzuExplorer.showGraph",
          "when": "view == kuzuExplorer.database && kuzuExplorer.connected",
          "group": "navigation@2"
        },
        {
          "command": "kuzuExplorer.refresh",
          "when": "view == kuzuExplorer.database && kuzuExplorer.connected",
          "group": "navigation@3"
        },
        {
          "command": "kuzuExplorer.disconnect",
          "when": "view == kuzuExplorer.database && kuzuExplorer.connected",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "kuzuExplorer.openTable",
          "when": "view == kuzuExplorer.database && viewItem == kuzuTable",
          "group": "inline"
        }
      ],
      "explorer/context": [
        {
          "command": "kuzuExplorer.openDatabaseFile",
          "when": "explorerResourceIsFolder || resourceExtname == .kuzu || resourceExtname == .kz || resourceExtname == .kuzudb || resourceExtname == .db",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "Kuzu Explorer",
      "properties": {
        "kuzuExplorer.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Path to the Node.js executable used to run the Kuzu database worker. The Kuzu native addon is loaded by this process, not by VS Code itself."
        },
        "kuzuExplorer.defaultReadOnly": {
          "type": "boolean",
          "default": true,
          "description": "Open databases in read-only mode by default. Read-only does not hold a write lock on the database."
        },
        "kuzuExplorer.rowLimit": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of rows fetched when browsing a table."
        },
        "kuzuExplorer.graphLimit": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of nodes/edges fetched per table for the graph view."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "cytoscape": "^3.30.0",
    "kuzu": "^0.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
